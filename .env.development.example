# YourMeal OS · Development Environment Contract
# HOUSEKEEPING-003
#
# Official contract of what a developer needs to work on this repo.
# Copy secrets to local `.env` (gitignored):
#   cp .env.development.example .env
#
# Validate anytime:
#   npm run doctor:env
#
# Never commit real passwords or live API keys.
# Lovable Cloud: set the same VITE_* keys in Project → Environment Variables.
#
# See: docs/00-status/ENVIRONMENT_CONTRACT.md · ADR 0049

# ------------------------------------------------------------
# Shell / toolchain (export in your shell profile — not always in .env)
# ------------------------------------------------------------
# JAVA_HOME must point to JDK 21 (JBR / Temurin). JDK 22+ → ERROR.
# JAVA_HOME="/path/to/jdk-21"
# ANDROID_HOME="$HOME/Library/Android/sdk"
# ANDROID_SDK_ROOT="$ANDROID_HOME"

# ------------------------------------------------------------
# Supabase · Single Source of Truth (INFRA-007)
# Project ref: djangucecsphnejplvic
# ------------------------------------------------------------
SUPABASE_PROJECT_ID="djangucecsphnejplvic"
SUPABASE_URL="https://djangucecsphnejplvic.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
# Optional — server/scripts only (never expose to Vite)
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_REPLACE_ME"

VITE_SUPABASE_PROJECT_ID="djangucecsphnejplvic"
VITE_SUPABASE_URL="https://djangucecsphnejplvic.supabase.co"
# REQUIRED for browser Auth. Replace REPLACE_ME, then restart `npm run dev`.
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# ------------------------------------------------------------
# Auth / bootstrap flags (defaults safe for local)
# ------------------------------------------------------------
VITE_AUTH_OAUTH_SOCIAL_ENABLED="false"
VITE_AUTH_PHONE_ENABLED="false"
VITE_BOOTSTRAP_MODE="false"
VITE_YMOS_RUNTIME_OVERLAY="false"

# ------------------------------------------------------------
# Analytics (optional until Product Core instrumentation)
# ------------------------------------------------------------
# VITE_POSTHOG_KEY=""
# VITE_POSTHOG_HOST="https://us.i.posthog.com"

# ------------------------------------------------------------
# App identity (optional)
# ------------------------------------------------------------
# VITE_APP_NAME="YourMeal OS"
# VITE_APP_VERSION="0.0.0"

# ------------------------------------------------------------
# Local smoke / scripts (do not commit real passwords)
# ------------------------------------------------------------
PS002_EMAIL=
PS002_PASSWORD=
# PS_BASE_URL="http://127.0.0.1:8080"
