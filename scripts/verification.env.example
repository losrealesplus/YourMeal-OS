# Documentation only. Scripts do not automatically load this file or dotenv.
# Supply values privately in the intended process environment, never CLI arguments.
# Production PROJECT_REF must identify EatClean. Staging must be an independent project.
# URLs must exactly equal https://<PROJECT_REF>.supabase.co (no trailing slash).
# SECRET_KEY requires sb_secret_; PUBLISHABLE_KEY requires sb_publishable_.
EATCLEAN_PRODUCTION_PROJECT_REF=
EATCLEAN_PRODUCTION_SUPABASE_URL=
EATCLEAN_PRODUCTION_SUPABASE_SECRET_KEY=
EATCLEAN_PRODUCTION_SUPABASE_PUBLISHABLE_KEY=
EATCLEAN_STAGING_PROJECT_REF=
EATCLEAN_STAGING_SUPABASE_URL=
EATCLEAN_STAGING_SUPABASE_SECRET_KEY=
EATCLEAN_STAGING_SUPABASE_PUBLISHABLE_KEY=
