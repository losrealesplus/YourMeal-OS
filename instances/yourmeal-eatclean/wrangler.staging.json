{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yourmeal-instance-eatclean-staging",
  "main": "../../.output/server/index.mjs",
  "find_additional_modules": true,
  "base_dir": "../../.output/server",
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs"]
    }
  ],
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "assets": {
    "directory": "../../.output/public",
    "binding": "ASSETS"
  },
  "vars": {
    "TENANT_SLUG": "eatclean-staging-unconfigured",
    "CORE_VERSION": "0.1.0",
    "SUPABASE_URL": "https://eatclean-staging-unconfigured.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_STAGING_UNCONFIGURED_REPLACE_ME"
  },
  "routes": [
    {
      "pattern": "eatclean-staging.yourmealos.com",
      "custom_domain": true
    }
  ]
}
