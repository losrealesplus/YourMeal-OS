# INFRA-007 · Official Supabase project (Single Source of Truth)
# Project ref: djangucecsphnejplvic
# Copy to local `.env` (gitignored) and fill secrets:
#   cp .env.example .env
# Lovable Cloud: set the same keys in Project → Environment Variables.
# See docs/10-validation/INFRA007_CUTOVER_PLAN.md
# Never put real passwords or real API keys in this file.
#
# AUTH-PIPELINE-002 · Vite SPA auth uses ONLY the VITE_* variables below.
# Leaving VITE_SUPABASE_PUBLISHABLE_KEY as sb_publishable_REPLACE_ME causes:
#   Supabase → "Invalid API key" (credentials are never checked).
# bootstrap:e2e / PS-002-C preflight will BLOCK until you replace it.
# SUPABASE_PUBLISHABLE_KEY alone does NOT authenticate the browser.

SUPABASE_PROJECT_ID="djangucecsphnejplvic"
SUPABASE_URL="https://djangucecsphnejplvic.supabase.co"
# Scripts / Node fallback — keep in sync with VITE_ below (same publishable key).
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
# Optional — server/scripts only (never expose to Vite)
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_REPLACE_ME"
# SUPABASE_ACCESS_TOKEN=  # CLI Management API (optional)
# SUPABASE_DB_PASSWORD=   # CLI db push / link (optional)

VITE_SUPABASE_PROJECT_ID="djangucecsphnejplvic"
VITE_SUPABASE_URL="https://djangucecsphnejplvic.supabase.co"
# REQUIRED for browser Auth (createClient). Replace REPLACE_ME with the
# publishable key from Supabase Dashboard → project djangucecsphnejplvic.
# Then restart `npm run dev` so Vite re-injects import.meta.env.
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# INFRA-005 · Show Google/Apple OAuth buttons on /auth (default false).
# OAuth implementation stays in src/auth/oauth.ts — this only gates UI.
VITE_AUTH_OAUTH_SOCIAL_ENABLED="false"

# PRODUCT-001 · Show Phone OTP tab on /auth (default false).
# Requires Supabase Dashboard Phone Auth + SMS provider. Code stays in credentials.ts.
VITE_AUTH_PHONE_ENABLED="false"

# EP-BOOTSTRAP-001 · Development Bootstrap Mode (default false).
# Injects a synthetic identity for RI-001 / Day-0 UI navigation without Supabase Auth.
# NEVER enable in production. See docs/00-status/BOOTSTRAP_MODE.md
VITE_BOOTSTRAP_MODE="false"

# YMOS Runtime Inspector (ANDROID-RUNTIME-002) · observe-only overlay (default false).
# Also: ?debug-runtime=1 · sessionStorage ymos.runtime-inspector=1 · long-press bottom-right.
VITE_YMOS_RUNTIME_OVERLAY="false"

# PS-002-C · Canonical Auth smoke
# Fill locally — do NOT commit real passwords to git.
PS002_EMAIL=
PS002_PASSWORD=
# PS_BASE_URL="http://127.0.0.1:8080"
