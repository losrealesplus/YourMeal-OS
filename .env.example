# INFRA-002 · Official Supabase project (Single Source of Truth)
# Project ref: djangucecsphnejplvic
# Copy to `.env` and fill keys from Dashboard → Project Settings → API
# Also set the same values in Lovable Cloud → Environment Variables

SUPABASE_PROJECT_ID="djangucecsphnejplvic"
SUPABASE_URL="https://djangucecsphnejplvic.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
# Optional — server/scripts only (never expose to Vite)
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_REPLACE_ME"
# SUPABASE_ACCESS_TOKEN=  # CLI Management API (optional)
# SUPABASE_DB_PASSWORD=   # CLI db push / link (optional)

VITE_SUPABASE_PROJECT_ID="djangucecsphnejplvic"
VITE_SUPABASE_URL="https://djangucecsphnejplvic.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# INFRA-005 · Show Google/Apple OAuth buttons on /auth (default false).
# OAuth implementation stays in src/auth/oauth.ts — this only gates UI.
VITE_AUTH_OAUTH_SOCIAL_ENABLED="false"

# PRODUCT-001 · Show Phone OTP tab on /auth (default false).
# Requires Supabase Dashboard Phone Auth + SMS provider. Code stays in credentials.ts.
VITE_AUTH_PHONE_ENABLED="false"

# EP-BOOTSTRAP-001 · Development Bootstrap Mode (default false).
# Injects a synthetic identity for RI-001 / Day-0 UI navigation without Supabase Auth.
# NEVER enable in production. See docs/00-status/BOOTSTRAP_MODE.md
VITE_BOOTSTRAP_MODE="false"

# PS-002-C · Canonical Auth smoke (never commit real passwords)
# PS002_EMAIL="owner@example.com"
# PS002_PASSWORD="…"
# PS_BASE_URL="http://127.0.0.1:8080"
