# Android Release Signing — local properties (gitignored)
#
# Copy: cp keystore.properties.example keystore.properties
# Fill values. NEVER commit keystore.properties or *.jks / *.keystore.
#
# Prefer environment variables in CI (same keys without file):
#   YOURMEAL_UPLOAD_STORE_FILE
#   YOURMEAL_UPLOAD_STORE_PASSWORD
#   YOURMEAL_UPLOAD_KEY_ALIAS
#   YOURMEAL_UPLOAD_KEY_PASSWORD
#
# storeFile may be absolute or relative to the android/ module.

storeFile=/absolute/path/to/yourmeal-upload.jks
storePassword=REPLACE_ME_STORE_PASSWORD
keyAlias=yourmeal_upload
keyPassword=REPLACE_ME_KEY_PASSWORD
